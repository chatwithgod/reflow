@@ -0,0 +1,158 @@
+//go:build reflow
+
+package gateway
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	adapter "github.com/chatwithgod/reflow/adapters/magpie"
+	"github.com/chatwithgod/reflow/core"
+	"github.com/tidwall/gjson"
+	"github.com/yetone/magpie/internal/gwexec"
+)
+
+func reflowSocketEngine(t *testing.T) {
+	t.Helper()
+	config := core.DefaultConfig()
+	config.MaxContinue = 1
+	engine, err := adapter.New(config)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(gwexec.Use(func(ctx context.Context, info gwexec.Info, body []byte, next gwexec.Next) (*http.Response, error) {
+		return engine.Execute(ctx, info.Scope, body, func(_ context.Context, b []byte) (*http.Response, error) { return next(b) })
+	}))
+}
+
+func reflowSocketReply(w http.ResponseWriter, id string, tokens int, tool bool) {
+	w.Header().Set("Content-Type", "text/event-stream")
+	for _, event := range reflowRound(id, tokens, tool) {
+		raw, _ := json.Marshal(event)
+		fmt.Fprintf(w, "data: %s\n\n", raw)
+		http.NewResponseController(w).Flush()
+	}
+}
+
+// Warmup stays local, even with Reflow enabled. The next delta keeps the
+// warmup's input exactly once; a reply is never looked up on another socket.
+func TestReflowSocketWarmupAndHistoryScope(t *testing.T) {
+	var calls atomic.Int32
+	chatgpt(t, func(w http.ResponseWriter, r *http.Request) {
+		raw, err := io.ReadAll(r.Body)
+		if err != nil {
+			t.Error(err)
+		}
+		if calls.Add(1) == 1 {
+			items := gjson.GetBytes(raw, "input").Array()
+			if len(items) != 2 || items[0].Get("content.0.text").String() != "hi" || items[1].Get("content.0.text").String() != "and more" {
+				t.Error("warmup input was lost or duplicated")
+			}
+			if gjson.GetBytes(raw, "generate").Exists() || gjson.GetBytes(raw, "previous_response_id").Exists() {
+				t.Error("socket-local fields went upstream")
+			}
+			reflowSocketReply(w, "warmup-follow", 516, false)
+			return
+		}
+		reflowSocketReply(w, "warmup-final", 20, false)
+	})
+	reflowSocketEngine(t)
+	_, server := sockServer(t)
+	header := http.Header{"Authorization": {"Bearer synthetic-reflow-token"}}
+	c, _, err := dialSock(t, server, CodexPath+"/responses", header)
+	if err != nil {
+		t.Fatal(err)
+	}
+	frame := func(prev, input string, extra ...string) string {
+		return string(rewriteModel([]byte(create(prev, input, extra...)), "gpt-6"))
+	}
+	warm := last(c.turn(frame("", userHi, `"generate":false`)))
+	if warm.Get("type").String() != "response.completed" || calls.Load() != 0 {
+		t.Fatal("warmup ran inference with Reflow enabled")
+	}
+	end := last(c.turn(frame(warm.Get("response.id").String(), userMore)))
+	if end.Get("type").String() != "response.completed" || calls.Load() != 2 {
+		t.Fatal("warmup follow-up did not complete exactly one continuation")
+	}
+	other, _, err := dialSock(t, server, CodexPath+"/responses", header)
+	if err != nil {
+		t.Fatal(err)
+	}
+	refused := last(other.turn(frame(end.Get("response.id").String(), userHi)))
+	if refused.Get("error.code").String() != "previous_response_not_found" || calls.Load() != 2 {
+		t.Fatal("response history crossed sockets")
+	}
+}
+
+// Interrupting the visible response must cancel a hidden continuation too.
+// Neither the discarded tool nor the interrupted response becomes history.
+func TestReflowSocketInterruptHiddenRound(t *testing.T) {
+	var calls atomic.Int32
+	started, canceled, release := make(chan struct{}), make(chan struct{}), make(chan struct{})
+	chatgpt(t, func(w http.ResponseWriter, r *http.Request) {
+		io.Copy(io.Discard, r.Body)
+		switch calls.Add(1) {
+		case 1:
+			reflowSocketReply(w, "interrupted-first", 516, true)
+		case 2:
+			close(started)
+			select {
+			case <-r.Context().Done():
+				close(canceled)
+			case <-release:
+			}
+		default:
+			reflowSocketReply(w, "after-interrupt", 20, false)
+		}
+	})
+	t.Cleanup(func() { close(release) })
+	reflowSocketEngine(t)
+	_, server := sockServer(t)
+	c, _, err := dialSock(t, server, CodexPath+"/responses", http.Header{"Authorization": {"Bearer synthetic-reflow-token"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	frame := func(prev string) string { return string(rewriteModel([]byte(create(prev, userHi)), "gpt-6")) }
+	c.send(frame(""))
+	got, err := c.until("response.created")
+	if err != nil || last(got).Get("response.id").String() != "interrupted-first" {
+		t.Fatal("visible response did not start")
+	}
+	select {
+	case <-started:
+	case <-time.After(30 * time.Second):
+		t.Fatal("hidden continuation did not start")
+	}
+	c.send(`{"type":"response.interrupt","response_id":"interrupted-first","mode":"discard_partial_items"}`)
+	got, err = c.until("response.incomplete")
+	if err != nil {
+		t.Fatal(err)
+	}
+	accepted := false
+	for _, event := range got {
+		accepted = accepted || event.Get("type").String() == "response.interrupt.accepted"
+		if event.Get("item.type").String() == "function_call" {
+			t.Error("discarded tool escaped before interruption")
+		}
+	}
+	if !accepted || last(got).Get("response.incomplete_details.reason").String() != "interrupted" {
+		t.Fatal("hidden continuation was not interrupted")
+	}
+	select {
+	case <-canceled:
+	case <-time.After(30 * time.Second):
+		t.Fatal("hidden continuation survived interruption")
+	}
+	if end := last(c.turn(frame("interrupted-first"))); end.Get("error.code").String() != "previous_response_not_found" || calls.Load() != 2 {
+		t.Fatal("interrupted response became reusable history")
+	}
+	if end := last(c.turn(frame(""))); end.Get("type").String() != "response.completed" || calls.Load() != 3 {
+		t.Fatal("socket failed to serve a fresh turn after interruption")
+	}
+}
