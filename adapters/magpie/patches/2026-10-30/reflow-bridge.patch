+//go:build reflow
+
+package reflow
+
+import (
+	"github.com/yetone/magpie/internal/gwexec"
+	"github.com/yetone/magpie/internal/pluginrt"
+	"testing"
+)
+
+func TestZeroDefaultAndRuntimeRemoval(t *testing.T) {
+	var manifest pluginrt.Manifest
+	for _, m := range pluginrt.Registered() {
+		if m.ID == "reflow" {
+			manifest = m
+		}
+	}
+	if manifest.ID == "" {
+		t.Fatal("adapter not registered")
+	}
+	rt := pluginrt.New([]pluginrt.Manifest{manifest})
+	defer rt.Stop()
+	rt.Reconcile(map[string]bool{"reflow": true}, map[string]map[string]any{"reflow": {"maxContinue": int64(0)}})
+	if gwexec.Current() != nil {
+		t.Fatal("default enabled reasoning continuation")
+	}
+	rt.Reconcile(map[string]bool{"reflow": false}, nil)
+	rt.Reconcile(map[string]bool{"reflow": true}, map[string]map[string]any{"reflow": {"maxContinue": int64(3)}})
+	if gwexec.Current() == nil {
+		t.Fatal("configured adapter did not serve")
+	}
+	rt.Reconcile(map[string]bool{"reflow": false}, nil)
+	if gwexec.Current() != nil {
+		t.Fatal("disabled adapter still served")
+	}
+}
