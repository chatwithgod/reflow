+//go:build reflow
+
+// Package reflow supplies the optional local Reflow execution adapter. The
+// separate build tag and zero continuation default keep activation explicit.
+package reflow
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+
+	adapter "github.com/chatwithgod/reflow/adapters/magpie"
+	"github.com/chatwithgod/reflow/core"
+	"github.com/yetone/magpie/internal/gwexec"
+	"github.com/yetone/magpie/internal/pluginrt"
+)
+
+type settings struct {
+	MaxContinue int `json:"maxContinue" title:"Additional reasoning rounds" description:"Zero disables continuation; extra rounds consume additional quota and time." min:"0" max:"7"`
+}
+
+func init() {
+	pluginrt.Register(pluginrt.Manifest{ID: "reflow", API: "^1", Requires: []string{"gateway"}, Name: "Reflow", Sub: "Bounded reasoning continuation on the selected Responses account", Settings: settings{}, Apply: func(c *pluginrt.Ctx) error {
+		b, err := json.Marshal(c.Config)
+		if err != nil {
+			return err
+		}
+		var options settings
+		if err = json.Unmarshal(b, &options); err != nil {
+			return err
+		}
+		if options.MaxContinue == 0 {
+			return nil
+		}
+		config := core.DefaultConfig()
+		config.MaxContinue = options.MaxContinue
+		engine, err := adapter.New(config)
+		if err != nil {
+			return err
+		}
+		c.OnDispose(gwexec.Use(func(ctx context.Context, info gwexec.Info, body []byte, next gwexec.Next) (*http.Response, error) {
+			return engine.Execute(ctx, info.Scope, body, func(_ context.Context, b []byte) (*http.Response, error) { return next(b) })
+		}))
+		return nil
+	}})
+}
