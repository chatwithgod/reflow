+// Hold a client open across the subtest's cleanup: closing only the listener
+// leaves its server goroutine in Scanner.Scan. Bound the old failure in a child
+// so it produces a test failure without stranding the rest of the package.
+func TestFakeNiriCleanupClosesAcceptedConnection(t *testing.T) {
+	const child = "MAGPIE_TEST_NIRI_CLEANUP_CHILD"
+	if os.Getenv(child) == "1" {
+		var c net.Conn
+		t.Cleanup(func() {
+			if c != nil {
+				c.Close()
+			}
+		})
+		t.Run("client_stays_open", func(t *testing.T) {
+			fakeNiri(t, func(string) string { return `{"Ok":"Handled"}` })
+			var err error
+			c, err = niriDial()
+			if err != nil {
+				t.Fatal(err)
+			}
+			if err := c.SetDeadline(time.Now().Add(10 * time.Second)); err != nil {
+				t.Fatal(err)
+			}
+			if _, err := io.WriteString(c, "\"FocusedOutput\"\n"); err != nil {
+				t.Fatal(err)
+			}
+			// A reply proves Accept completed; the client stays open until the
+			// outer test cleans up, after fakeNiri must have stopped its reader.
+			reply, err := bufio.NewReader(c).ReadString('\n')
+			if err != nil || reply != "{\"Ok\":\"Handled\"}\n" {
+				t.Fatalf("fixture handshake: reply=%q err=%v", reply, err)
+			}
+		})
+		return
+	}
+	// These are deadlock guards, not performance assertions. The child has
+	// enough time for its handshake and emits stacks before the outer guard.
+	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
+	defer cancel()
+	cmd := proc.CommandContext(ctx, os.Args[0], "-test.run=^TestFakeNiriCleanupClosesAcceptedConnection$", "-test.timeout=20s")
+	cmd.Env = append(os.Environ(), child+"=1")
+	output, err := cmd.CombinedOutput()
+	if ctx.Err() != nil || err != nil {
+		t.Fatalf("niri fixture cleanup did not release an accepted connection: %v\n%s", err, output)
+	}
+}
