diff --git a/internal/gui/tests/reflow-settings.test.cjs b/internal/gui/tests/reflow-settings.test.cjs
new file mode 100644
index 0000000..04f5e22
--- /dev/null
+++ b/internal/gui/tests/reflow-settings.test.cjs
@@ -0,0 +1,125 @@
+// Optional Reflow settings through the real page, using isolated API fixtures.
+// MAGPIE_REFLOW_ASSETS selects older assets for the untranslated negative case.
+const assert = require("node:assert/strict");
+const fs = require("node:fs/promises");
+const path = require("node:path");
+const { test } = require("node:test");
+const { chromium, webkit } = require("playwright");
+
+const assets = process.env.MAGPIE_REFLOW_ASSETS || path.resolve(__dirname, "../assets");
+const sub = "Bounded reasoning continuation on the selected Responses account";
+const title = "Additional reasoning rounds";
+const help = "Zero disables continuation; extra rounds consume additional quota and time.";
+const schema = {
+  type: "object",
+  properties: { maxContinue: { type: "integer", title, description: help, minimum: 0, maximum: 7 } },
+  "x-order": ["maxContinue"],
+};
+
+function server(lang, posts) {
+  let on = true;
+  const config = { maxContinue: 0 };
+  const list = () => [{ id: "reflow", name: "Reflow", sub, on, chosen: on, source: "user", state: on ? "active" : "disposed", inUse: 0, schema, config }];
+  const settings = () => ({
+    theme: "light", lang, tray: "panel", currency: "usd", textSize: 100, redactWords: [],
+    codexWarmup: "", claudeWarmup: "", codexWarmAt: "", claudeWarmAt: "", visionModels: [], imageGenModels: [], workbuddyCheckins: [],
+    version: "fixture", dir: "/fixture", gateway: "http://127.0.0.1:3999", proxyNow: "none", proxySource: "none", lanURLs: [],
+    fx: { rate: 7.2, at: new Date().toISOString(), stale: false }, builtins: list(),
+  });
+  return async (route) => {
+    const request = route.request(), url = new URL(request.url());
+    const json = (data) => route.fulfill({ json: data });
+    if (url.host !== "magpie.test") return route.fulfill({ status: 404, body: "" });
+    if (url.pathname === "/boot.js") return route.fulfill({ contentType: "text/javascript", body: `window.bootPrefs = ${JSON.stringify({ lang, theme: "light", featuresOff: [], pluginConfig: { reflow: config } })};` });
+    if (url.pathname === "/wails/runtime.js") return route.fulfill({ contentType: "text/javascript", body: "export const Window = {};" });
+    if (url.pathname === "/api/state") return json({ agents: [], profiles: [], settings: settings(), fx: settings().fx });
+    if (url.pathname === "/api/settings") return json(settings());
+    if (url.pathname === "/api/plugins/builtin") {
+      if (request.method() === "POST") {
+        const body = request.postDataJSON();
+        if (body.id !== "reflow") return route.fulfill({ status: 400, json: { error: "unknown fixture plugin" } });
+        if (body.config) {
+          const value = body.config.maxContinue;
+          if (!Number.isInteger(value) || value < 0 || value > 7) return route.fulfill({ status: 400, json: { error: "invalid round count" } });
+          config.maxContinue = value;
+        } else if (typeof body.on === "boolean") on = body.on;
+        else return route.fulfill({ status: 400, json: { error: "missing change" } });
+        posts.push(body);
+      }
+      return json(list());
+    }
+    if (url.pathname === "/api/providers") return json({ providers: [], presets: [], excluded: [], gateway: { running: true, window: true }, plugins: [] });
+    if (url.pathname === "/api/plugins") return json({ bun: true, plugins: [], picker: false, movable: [] });
+    if (url.pathname === "/api/plugins/listings") return json({ listings: [] });
+    if (url.pathname === "/api/plugins/github") return json({ repos: [] });
+    if (url.pathname === "/api/usage/quotas") return json([]);
+    if (url.pathname === "/api/groups") return json({ groups: [], models: [] });
+    if (url.pathname === "/api/window/fit") return route.fulfill({ status: 204 });
+    if (url.pathname.startsWith("/api/")) return json({});
+    const file = path.join(assets, url.pathname === "/" ? "index.html" : url.pathname);
+    const contentType = { ".html": "text/html", ".js": "text/javascript", ".css": "text/css", ".svg": "image/svg+xml", ".png": "image/png" }[path.extname(file)];
+    try { return await route.fulfill({ body: await fs.readFile(file), contentType }); }
+    catch { return route.fulfill({ status: 404, body: "" }); }
+  };
+}
+
+for (const engine of (process.env.BROWSER ? [process.env.BROWSER] : ["chromium", "webkit"])) {
+  test(`${engine}: Reflow has translated bounded round controls and keeps zero`, async (t) => {
+    const browser = await (engine === "webkit" ? webkit.launch() : chromium.launch({ channel: "chromium" }));
+    t.after(() => browser.close());
+    for (const lang of ["en", "zh", "zh-TW", "ja", "de"]) {
+      const context = await browser.newContext({ viewport: { width: 420, height: 760 }, reducedMotion: "reduce" });
+      const page = await context.newPage();
+      page.setDefaultTimeout(8000);
+      const posts = [], errors = [];
+      page.on("pageerror", (error) => errors.push(error.message));
+      await page.route("**/*", server(lang, posts));
+      await page.goto("http://magpie.test/?view=plugins");
+      await page.locator("#view-plugins .lib-tabs .opt").first().click();
+      const row = page.locator('#builtinList .feat-row[data-id="reflow"]');
+      const setting = page.locator('#builtinList .feat-set[data-of="reflow"][data-setting="maxContinue"]');
+      const input = setting.locator('input[type="number"]');
+      await input.waitFor();
+      assert.equal(await row.locator(".name").textContent(), "Reflow", lang);
+      for (const [selector, key] of [[row.locator(".sub"), sub], [setting.locator(".name"), title], [setting.locator(".sub"), help]]) {
+        const translated = await page.evaluate((key) => t(key), key);
+        assert.equal(await selector.textContent(), translated, lang);
+        if (lang !== "en") assert.notEqual(translated, key, `${lang}: translated ${key}`);
+      }
+      assert.equal(await input.inputValue(), "0", `${lang}: default zero`);
+      assert.equal(await input.getAttribute("min"), "0");
+      assert.equal(await input.getAttribute("max"), "7");
+      assert.equal(await input.getAttribute("step"), "1");
+      const change = async (value) => {
+        const response = page.waitForResponse((response) => new URL(response.url()).pathname === "/api/plugins/builtin" && response.request().method() === "POST");
+        await input.fill(String(value));
+        await input.press("Tab");
+        assert.equal((await response).status(), 200);
+        await page.waitForFunction((value) => document.querySelector('[data-of="reflow"] input')?.value === String(value), value);
+      };
+      await change(3);
+      assert.deepEqual(posts, [{ id: "reflow", config: { maxContinue: 3 } }]);
+      for (const invalid of ["-1", "8", "1.5", ""]) {
+        await input.fill(invalid);
+        await input.press("Tab");
+        assert.equal(await input.getAttribute("aria-invalid"), "true");
+        assert.equal(posts.length, 1, `${lang}: invalid input posts nothing`);
+      }
+      await change(7);
+      for (const enabled of [false, true]) {
+        const response = page.waitForResponse((response) => new URL(response.url()).pathname === "/api/plugins/builtin" && response.request().method() === "POST");
+        await row.locator('[role="switch"]').click();
+        assert.equal((await response).status(), 200);
+        await page.waitForFunction((enabled) => document.querySelector('[data-id="reflow"] [role="switch"]')?.getAttribute("aria-checked") === String(enabled), enabled);
+      }
+      assert.equal(await input.inputValue(), "7", `${lang}: turning the plugin off keeps its setting`);
+      await change(0);
+      await page.reload();
+      await page.locator("#view-plugins .lib-tabs .opt").first().click();
+      assert.equal(await input.inputValue(), "0", `${lang}: zero survives reload`);
+      assert.deepEqual(errors, [], lang);
+      assert.ok(await page.evaluate(() => { const view = document.querySelector("#view-plugins"); return view.scrollWidth <= view.clientWidth + 1; }), `${lang}: fits`);
+      await context.close();
+    }
+  });
+}
