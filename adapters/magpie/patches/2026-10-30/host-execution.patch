+package gateway
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync/atomic"
+	"testing"
+
+	"github.com/yetone/magpie/internal/gwexec"
+	"github.com/yetone/magpie/internal/provider"
+)
+
+func TestExecutionExtensionLeavesTranslatedRoutesAlone(t *testing.T) {
+	var calls atomic.Int32
+	up := chatgpt(t, func(w http.ResponseWriter, r *http.Request) {
+		calls.Add(1)
+		w.Header().Set("Content-Type", "text/event-stream")
+		io.WriteString(w, "data: {\"type\":\"response.created\",\"response\":{\"id\":\"ordinary\"}}\n\n")
+		io.WriteString(w, "data: {\"type\":\"response.output_text.delta\",\"delta\":\"ordinary translated answer\",\"output_index\":0}\n\n")
+		io.WriteString(w, "data: {\"type\":\"response.completed\",\"response\":{\"id\":\"ordinary\",\"status\":\"completed\",\"usage\":{\"input_tokens\":100,\"output_tokens\":526,\"output_tokens_details\":{\"reasoning_tokens\":516}}}}\n\n")
+	})
+	if err := provider.Save(provider.Provider{ID: "execution-fixture", Name: "Execution fixture", Key: "synthetic-key", Models: []string{"gpt-6"}, Responses: up.URL + "/v1"}); err != nil {
+		t.Fatal(err)
+	}
+	var entered atomic.Int32
+	stop := gwexec.Use(func(context.Context, gwexec.Info, []byte, gwexec.Next) (*http.Response, error) {
+		entered.Add(1)
+		return nil, errors.New("translated route entered execution extension")
+	})
+	defer stop()
+	server := httptest.NewServer(lanGuard(New().Handler()))
+	defer server.Close()
+	res, err := server.Client().Post(server.URL+"/v1/chat/completions", "application/json", strings.NewReader(`{"model":"execution-fixture/gpt-6","stream":true,"messages":[{"role":"user","content":"synthetic request"}]}`))
+	if err != nil {
+		t.Fatal(err)
+	}
+	body, err := io.ReadAll(res.Body)
+	res.Body.Close()
+	if err != nil || res.StatusCode != 200 || calls.Load() != 1 || entered.Load() != 0 || !strings.Contains(string(body), "ordinary translated answer") {
+		t.Fatalf("status=%d calls=%d entered=%d err=%v body=%s", res.StatusCode, calls.Load(), entered.Load(), err, body)
+	}
+}
