@@ -0,0 +1,69 @@
+package gateway
+
+import (
+	"context"
+	"fmt"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/yetone/magpie/internal/gwexec"
+)
+
+// The test crosses the real server guards, native sign-in route, signing and
+// transport. A helper-only call would not prove the extension is wired in.
+func TestExecutionExtensionThroughNativeCodexGateway(t *testing.T) {
+	var mu sync.Mutex
+	var bodies []string
+	chatgpt(t, func(w http.ResponseWriter, r *http.Request) {
+		body, _ := io.ReadAll(r.Body)
+		mu.Lock()
+		bodies = append(bodies, string(body))
+		n := len(bodies)
+		mu.Unlock()
+		if r.Header.Get("Authorization") != "Bearer synthetic-execution-token" || r.Header.Get("chatgpt-account-id") != "execution-account" {
+			t.Error("round changed its account")
+		}
+		w.Header().Set("Content-Type", "text/event-stream")
+		fmt.Fprintf(w, "data: {\"type\":\"response.created\",\"response\":{\"id\":\"round-%d\",\"status\":\"in_progress\"}}\n\n", n)
+		fmt.Fprintf(w, "data: {\"type\":\"response.completed\",\"response\":{\"id\":\"round-%d\",\"status\":\"completed\",\"output\":[],\"usage\":{\"input_tokens\":10,\"output_tokens\":20}}}\n\n", n)
+	})
+	stop := gwexec.Use(func(_ context.Context, info gwexec.Info, body []byte, next gwexec.Next) (*http.Response, error) {
+		if info.Protocol != "responses" || info.Model != "gpt-5.5" || len(info.Scope) != 64 || strings.Contains(info.Scope, "token") {
+			t.Error("incorrect or private execution metadata")
+		}
+		first, err := next(body)
+		if err != nil {
+			return nil, err
+		}
+		_, err = io.Copy(io.Discard, first.Body)
+		first.Body.Close()
+		if err != nil {
+			return nil, err
+		}
+		return next([]byte(`{"model":"gpt-5.5","stream":true,"input":[{"role":"user","content":"synthetic continuation"}]}`))
+	})
+	defer stop()
+	server := httptest.NewServer(lanGuard(New().Handler()))
+	defer server.Close()
+	req, _ := http.NewRequest(http.MethodPost, server.URL+CodexPath+"/responses", strings.NewReader(`{"model":"gpt-5.5","stream":true,"input":[]}`))
+	req.Header.Set("Authorization", "Bearer synthetic-execution-token")
+	req.Header.Set("chatgpt-account-id", "execution-account")
+	res, err := server.Client().Do(req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	got, err := io.ReadAll(res.Body)
+	res.Body.Close()
+	if err != nil {
+		t.Fatal(err)
+	}
+	mu.Lock()
+	defer mu.Unlock()
+	if res.StatusCode != 200 || len(bodies) != 2 || !strings.Contains(bodies[1], "synthetic continuation") || strings.Contains(string(got), "round-1") || !strings.Contains(string(got), "round-2") {
+		t.Fatalf("status=%d requests=%d client=%s", res.StatusCode, len(bodies), got)
+	}
+}
