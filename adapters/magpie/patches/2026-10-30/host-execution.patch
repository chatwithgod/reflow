diff --git a/internal/gwexec/gwexec.go b/internal/gwexec/gwexec.go
new file mode 100644
index 0000000..7563848
--- /dev/null
+++ b/internal/gwexec/gwexec.go
@@ -0,0 +1,148 @@
+// Package gwexec lets a compiled extension execute bounded Responses rounds on
+// the already selected provider. The gateway owns signing, routing and limits.
+package gwexec
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"io"
+	"net/http"
+	"slices"
+	"sync"
+)
+
+// Info contains no credentials. Scope is an opaque account-and-endpoint key for
+// separating in-memory continuation state; it must not be persisted or logged.
+type Info struct {
+	Protocol, Model, Path, Scope string
+	Stream                       bool
+}
+
+// Next sends a body through the same provider, identity, context and limits.
+// Close each reply before asking again. There is no automatic retry on failure.
+type Next func(body []byte) (*http.Response, error)
+type Executor func(context.Context, Info, []byte, Next) (*http.Response, error)
+
+const MaxCalls = 8
+
+var registry struct {
+	sync.Mutex
+	list []*Executor
+}
+
+// Use serves one executor until removed. The last registered serves; executors
+// are not chained, so their additional-call budgets cannot multiply.
+func Use(e Executor) func() {
+	if e == nil {
+		return func() {}
+	}
+	entry := &e
+	registry.Lock()
+	registry.list = append(registry.list, entry)
+	registry.Unlock()
+	var once sync.Once
+	return func() {
+		once.Do(func() {
+			registry.Lock()
+			defer registry.Unlock()
+			registry.list = slices.DeleteFunc(registry.list, func(p *Executor) bool { return p == entry })
+		})
+	}
+}
+
+func Current() Executor {
+	registry.Lock()
+	defer registry.Unlock()
+	if len(registry.list) == 0 {
+		return nil
+	}
+	return *registry.list[len(registry.list)-1]
+}
+
+// Run bounds an extension to MaxCalls and the client's lifetime. A failing or
+// panicking extension is an error, never a second execution of the first round.
+func Run(ctx context.Context, e Executor, info Info, body []byte, next Next) (res *http.Response, err error) {
+	if e == nil {
+		return next(body)
+	}
+	var mu sync.Mutex
+	calls := 0
+	var pending *trackedBody
+	guarded := func(body []byte) (*http.Response, error) {
+		mu.Lock()
+		if ctx.Err() != nil {
+			mu.Unlock()
+			return nil, ctx.Err()
+		}
+		if pending != nil {
+			mu.Unlock()
+			return nil, errors.New("execution extension must close the previous reply")
+		}
+		if calls >= MaxCalls {
+			mu.Unlock()
+			return nil, errors.New("execution extension call budget exhausted")
+		}
+		calls++
+		owned := &trackedBody{}
+		pending = owned
+		mu.Unlock()
+		r, err := next(bytes.Clone(body))
+		mu.Lock()
+		if err != nil || r == nil || r.Body == nil {
+			pending = nil
+			mu.Unlock()
+			if r != nil && r.Body != nil {
+				r.Body.Close()
+			}
+			if err == nil {
+				err = errors.New("execution callback returned no response body")
+			}
+			return nil, err
+		}
+		owned.ReadCloser = r.Body
+		owned.closed = func() {
+			mu.Lock()
+			if pending == owned {
+				pending = nil
+			}
+			mu.Unlock()
+		}
+		r.Body = owned
+		mu.Unlock()
+		return r, nil
+	}
+	defer func() {
+		if recover() != nil {
+			res = nil
+			err = errors.New("execution extension failed")
+		}
+		if res == nil && err == nil {
+			err = errors.New("execution extension returned no response")
+		}
+		if err != nil {
+			mu.Lock()
+			p := pending
+			if p != nil && p.ReadCloser == nil {
+				p = nil
+			}
+			mu.Unlock()
+			if p != nil {
+				p.Close()
+			}
+		}
+	}()
+	return e(ctx, info, bytes.Clone(body), guarded)
+}
+
+type trackedBody struct {
+	io.ReadCloser
+	once     sync.Once
+	closed   func()
+	closeErr error
+}
+
+func (b *trackedBody) Close() error {
+	b.once.Do(func() { b.closeErr = b.ReadCloser.Close(); b.closed() })
+	return b.closeErr
+}
