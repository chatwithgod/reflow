+
+func TestBoundsCancellationAndNoFailureReplay(t *testing.T) {
+	for _, kind := range []string{"budget", "unclosed", "canceled", "panic", "failure"} {
+		t.Run(kind, func(t *testing.T) {
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			calls := 0
+			send := func(b []byte) (*http.Response, error) {
+				calls++
+				return &http.Response{StatusCode: 200, Body: io.NopCloser(strings.NewReader("upstream"))}, nil
+			}
+			execute := func(ctx context.Context, _ Info, body []byte, next Next) (*http.Response, error) {
+				if kind == "canceled" {
+					cancel()
+					return next(body)
+				}
+				res, err := next(body)
+				if err != nil {
+					return nil, err
+				}
+				if kind == "panic" {
+					panic("private contents must not enter diagnostics")
+				}
+				if kind == "failure" {
+					return nil, errors.New("stopped")
+				}
+				if kind == "unclosed" {
+					return next(body)
+				}
+				res.Body.Close()
+				for i := 1; i <= MaxCalls; i++ {
+					res, err = next(body)
+					if err != nil {
+						return nil, err
+					}
+					res.Body.Close()
+				}
+				return res, nil
+			}
+			_, err := Run(ctx, execute, Info{}, []byte(`{"stream":true}`), send)
+			if err == nil {
+				t.Fatal("extension escaped its boundary")
+			}
+			want := 1
+			if kind == "budget" {
+				want = MaxCalls
+			}
+			if kind == "canceled" {
+				want = 0
+			}
+			if calls != want {
+				t.Fatalf("upstream calls=%d, want %d", calls, want)
+			}
+			if strings.Contains(err.Error(), "private") {
+				t.Fatal("panic content leaked")
+			}
+		})
+	}
+}
+
+func TestRegistrationRemovalAndUnchangedDefault(t *testing.T) {
+	count := 0
+	send := func(body []byte) (*http.Response, error) {
+		count++
+		if string(body) != "original" {
+			t.Error("default changed bytes")
+		}
+		return &http.Response{Body: io.NopCloser(strings.NewReader("ok"))}, nil
+	}
+	res, err := Run(context.Background(), Current(), Info{}, []byte("original"), send)
+	if err != nil {
+		t.Fatal(err)
+	}
+	res.Body.Close()
+	remove := Use(func(_ context.Context, _ Info, b []byte, n Next) (*http.Response, error) { return n(b) })
+	if Current() == nil {
+		t.Fatal("executor not registered")
+	}
+	remove()
+	remove()
+	if Current() != nil || count != 1 {
+		t.Fatal("removed executor still active or default executed twice")
+	}
+}
