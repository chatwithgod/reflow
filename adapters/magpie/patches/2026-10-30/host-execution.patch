diff --git a/internal/gateway/execution.go b/internal/gateway/execution.go
new file mode 100644
index 0000000..d7e00f1
--- /dev/null
+++ b/internal/gateway/execution.go
@@ -0,0 +1,86 @@
+package gateway
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"io"
+	"net/http"
+	"strings"
+	"sync"
+
+	"github.com/yetone/magpie/internal/gwexec"
+	"github.com/yetone/magpie/internal/provider"
+)
+
+// executeResponses is a post-signing extension for a streamed Responses turn.
+// Each extra round retains the target and identity and goes through the same
+// transport, so its rate limit and cancellation still apply.
+func executeResponses(req *http.Request, body []byte, proto provider.Protocol, compatible bool, owner string, send func(*http.Request) (*http.Response, error)) (*http.Response, error) {
+	e := gwexec.Current()
+	if e == nil || !compatible || proto != provider.Responses || req.Method != http.MethodPost || !strings.HasSuffix(req.URL.Path, "/responses") || !streamOf(body) || req.Header.Get("Authorization") == "" {
+		return send(req)
+	}
+	scope := sha256.Sum256([]byte(owner + "\x00" + req.URL.String() + "\x00" + req.Header.Get("Authorization") + "\x00" + req.Header.Get("Chatgpt-Account-Id")))
+	info := gwexec.Info{Protocol: string(proto), Model: modelOf(body), Path: req.URL.Path, Stream: true, Scope: hex.EncodeToString(scope[:])}
+	ctx, cancel := context.WithCancel(req.Context())
+	req = req.Clone(ctx)
+	first := true
+	res, err := gwexec.Run(req.Context(), e, info, body, func(next []byte) (*http.Response, error) {
+		if modelOf(next) != info.Model || !streamOf(next) {
+			return nil, errors.New("execution extension cannot change the selected model or streaming mode")
+		}
+		if first && bytes.Equal(next, body) {
+			first = false
+			return send(req)
+		}
+		additional := !first
+		first = false
+		r := req.Clone(req.Context())
+		r.Header.Del("Content-Encoding")
+		r.Header.Del("Content-Length")
+		if additional {
+			r.Header.Del("Idempotency-Key")
+			r.Header.Del("X-Idempotency-Key")
+		}
+		provider.SetBody(r, next)
+		defer provider.LetGo(r)
+		if strings.EqualFold(req.Header.Get("Content-Encoding"), "zstd") {
+			provider.CodexCompressed(r, next)
+		}
+		return send(r)
+	})
+	if err != nil {
+		cancel()
+		return res, err
+	}
+	res.Body = &executionBody{ReadCloser: res.Body, cancel: cancel}
+	return res, nil
+}
+
+type executionResponsesKey struct{}
+
+func executionOwner(p *provider.Provider) string {
+	if p == nil {
+		return "native"
+	}
+	owner := p.ID
+	if p.Account != nil {
+		owner += "\x00" + p.Account.User
+	}
+	return owner
+}
+
+type executionBody struct {
+	io.ReadCloser
+	cancel context.CancelFunc
+	once   sync.Once
+	err    error
+}
+
+func (b *executionBody) Close() error {
+	b.once.Do(func() { b.cancel(); b.err = b.ReadCloser.Close() })
+	return b.err
+}
