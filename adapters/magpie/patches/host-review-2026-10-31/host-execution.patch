@@ -0,0 +1,39 @@
+package gateway
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/yetone/magpie/internal/provider"
+)
+
+func TestFoldedUsageCountsUpstreamWithoutChangingClientContext(t *testing.T) {
+	for _, stream := range []bool{false, true} {
+		body := `{"id":"visible","usage":{"input_tokens":100,"output_tokens":546},"metadata":{"proxy_rounds":[{"round":1},{"round":2}],"proxy_billed_usage":{"input_tokens":200,"output_tokens":556,"input_tokens_details":{"cached_tokens":50},"output_tokens_details":{"reasoning_tokens":536}}}}`
+		ct := "application/json"
+		if stream {
+			ct = "text/event-stream"
+			body = "data: {\"type\":\"response.completed\",\"response\":" + body + "}\n\n"
+		}
+		s := newSniffer(provider.Responses, ct)
+		s.write([]byte(body))
+		u := s.usage()
+		if u.Input != 150 || u.CacheRead != 50 || u.Output != 556 || u.Reasoning != 536 {
+			t.Fatalf("stream=%t usage=%+v", stream, u)
+		}
+		bad := strings.Replace(body, `"cached_tokens":50`, `"cached_tokens":-1`, 1)
+		s = newSniffer(provider.Responses, ct)
+		s.write([]byte(bad))
+		u = s.usage()
+		if u.Input != 100 || u.Output != 546 {
+			t.Fatal("invalid accounting replaced visible usage")
+		}
+		bad = strings.Replace(body, `"cached_tokens":50`, `"cached_tokens":200`, 1)
+		s = newSniffer(provider.Responses, ct)
+		s.write([]byte(bad))
+		u = s.usage()
+		if u.Input != 100 || u.CacheRead != 0 || u.Output != 546 {
+			t.Fatal("metadata lowered the upstream's ordinary accounting")
+		}
+	}
+}
