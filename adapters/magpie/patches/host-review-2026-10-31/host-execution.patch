@@ -0,0 +1,27 @@
+package gateway
+
+import "encoding/json"
+
+// responsesAccountedUsage reads the optional folded-response accounting block.
+// The ordinary usage remains in the untouched client stream: it describes one
+// visible context, while proxy_billed_usage counts every upstream round.
+func responsesAccountedUsage(visible *rUsage, metadata json.RawMessage) Usage {
+	var extra struct {
+		Billed *rUsage           `json:"proxy_billed_usage"`
+		Rounds []json.RawMessage `json:"proxy_rounds"`
+	}
+	if len(metadata) == 0 || json.Unmarshal(metadata, &extra) != nil || extra.Billed == nil || len(extra.Rounds) == 0 || len(extra.Rounds) > 17 {
+		return visible.usage()
+	}
+	b := extra.Billed
+	d := b.InputTokensDetails
+	// Malformed metadata never suppresses the vendor's ordinary usage.
+	if b.InputTokens < visible.InputTokens || b.OutputTokens < visible.OutputTokens || d.CachedTokens < 0 || d.CacheWriteTokens < 0 || d.CachedTokens > b.InputTokens || d.CacheWriteTokens > b.InputTokens-d.CachedTokens || b.OutputTokensDetails.ReasoningTokens < 0 || b.OutputTokensDetails.ReasoningTokens > b.OutputTokens || b.InputTokens < 0 || b.OutputTokens < 0 {
+		return visible.usage()
+	}
+	accounted, ordinary := b.usage(), visible.usage()
+	if accounted.Input < ordinary.Input || accounted.CacheRead < ordinary.CacheRead || accounted.CacheWrite < ordinary.CacheWrite || accounted.Reasoning < ordinary.Reasoning {
+		return ordinary
+	}
+	return accounted
+}
