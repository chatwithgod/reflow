From 86f6f917f1f29740e42ef1d45a293761ddac2c06 Mon Sep 17 00:00:00 2001
From: chatwithgod <283797944+chatwithgod@users.noreply.github.com>
Date: Mon, 26 Oct 2026 18:26:16 +0800
Subject: [PATCH] gateway: stop cgroup fixture traversal at the host path root

Linux cgroup fixtures run on Windows too. filepath.Dir reaches a backslash root there, so comparing only with a slash made TestClaudeMemRunsFromTheCgroup loop indefinitely. Stop when the parent is the same path; Linux traversal retains its existing behavior.

Verified TestClaudeMemRunsFromTheCgroup and the bounded child-process regression TestCgroupRootWalkTerminates on Windows. Restoring the old comparison makes the regression fail with "cgroup parent walk did not terminate at the host filesystem root"; fixed source restored. Full-suite validation is tracked separately; no live account or production gateway was used.
---
 internal/gateway/claude_cgroup_root_test.go | 34 +++++++++++++++++++++
 internal/gateway/claude_room.go             |  2 +-
 2 files changed, 35 insertions(+), 1 deletion(-)
 create mode 100644 internal/gateway/claude_cgroup_root_test.go

diff --git a/internal/gateway/claude_cgroup_root_test.go b/internal/gateway/claude_cgroup_root_test.go
new file mode 100644
index 00000000..2ff619be
--- /dev/null
+++ b/internal/gateway/claude_cgroup_root_test.go
@@ -0,0 +1,34 @@
+package gateway
+
+import (
+	"context"
+	"os"
+	"testing"
+	"time"
+
+	"github.com/yetone/magpie/internal/proc"
+)
+
+// A Linux cgroup fixture is also read on Windows. Isolate its termination
+// check in a child so a broken parent walk cannot leave a spinning goroutine.
+func TestCgroupRootWalkTerminates(t *testing.T) {
+	const child = "MAGPIE_TEST_CGROUP_WALK_CHILD"
+	if os.Getenv(child) == "1" {
+		root := memFixture(t, map[string]string{"proc/meminfo": "MemTotal: 1024 kB\n", "proc/self/cgroup": "0::/\n", "sys/fs/cgroup/memory.max": "max\n"})
+		if limit, why := memLimit("linux", root); limit != 1024<<10 || why != "MemTotal" {
+			t.Fatalf("root walk returned %d (%s)", limit, why)
+		}
+		return
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
+	defer cancel()
+	cmd := proc.CommandContext(ctx, os.Args[0], "-test.run=^TestCgroupRootWalkTerminates$")
+	cmd.Env = append(os.Environ(), child+"=1")
+	output, err := cmd.CombinedOutput()
+	if ctx.Err() != nil {
+		t.Fatal("cgroup parent walk did not terminate at the host filesystem root")
+	}
+	if err != nil {
+		t.Fatalf("cgroup root child: %v\n%s", err, output)
+	}
+}
diff --git a/internal/gateway/claude_room.go b/internal/gateway/claude_room.go
index 00bded5d..7abcd6bc 100644
--- a/internal/gateway/claude_room.go
+++ b/internal/gateway/claude_room.go
@@ -170,7 +170,7 @@ func memLimit(goos, root string) (int64, string) {
 						least(n, "cgroup "+filepath.Join(dir, name))
 					}
 				}
-				if dir == "/" {
+				if filepath.Dir(dir) == dir {
 					break
 				}
 			}
-- 
