+package gateway
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"testing/synctest"
+	"time"
+
+	"github.com/yetone/magpie/internal/gwmw"
+	"github.com/yetone/magpie/internal/masking"
+	"github.com/yetone/magpie/internal/maskrec"
+	"github.com/yetone/magpie/internal/settings"
+)
+
+const timedPlaceholder = "{{WORD_12345678}}"
+
+// Delay only the virtual clock: no network, busy loop or real-time minimum.
+type timedMasker struct {
+	masking.Masker
+	delay time.Duration
+}
+
+func (m timedMasker) JSONHitsContext(context.Context, []byte) ([]byte, []gwmw.Hit) {
+	time.Sleep(m.delay)
+	return []byte(`{"text":"` + timedPlaceholder + `"}`), []gwmw.Hit{{Placeholder: timedPlaceholder, Kind: "WORD", By: "yours", Len: 7}}
+}
+
+func (m timedMasker) TextHitsContext(context.Context, string) (string, []gwmw.Hit) {
+	time.Sleep(m.delay)
+	return timedPlaceholder, []gwmw.Hit{{Placeholder: timedPlaceholder, Kind: "WORD", By: "yours", Len: 7}}
+}
+
+func (timedMasker) Writer(w http.ResponseWriter) (http.ResponseWriter, func()) {
+	return w, func() {}
+}
+
+// Both masking paths must measure elapsed time and preserve it in the record.
+// An actual clock may not advance between samples, and integer microseconds
+// must keep zero valid while still retaining a nonzero elapsed duration.
+func TestMaskingDurationPreserved(t *testing.T) {
+	for _, kind := range []string{"json", "text"} {
+		for _, tc := range []struct {
+			elapsed time.Duration
+			micros  int64
+		}{
+			{0, 0},
+			{500 * time.Nanosecond, 0},
+			{37 * time.Microsecond, 37},
+		} {
+			t.Run(kind+"/"+tc.elapsed.String(), func(t *testing.T) {
+				fresh(t)
+				if err := settings.Save(settings.Settings{Redact: true}); err != nil {
+					t.Fatal(err)
+				}
+				t.Cleanup(gwmw.Mask(timedMasker{delay: tc.elapsed}))
+				synctest.Test(t, func(t *testing.T) {
+					var hits maskHits
+					var sent string
+					if kind == "json" {
+						_, body, done, got, err := redactedHits(context.Background(), httptest.NewRecorder(), []byte(`{"text":"fixture"}`))
+						if err != nil {
+							t.Fatal(err)
+						}
+						done()
+						hits, sent = got, string(body)
+					} else {
+						_, text, got, err := maskTextHits(context.Background(), "fixture")
+						if err != nil {
+							t.Fatal(err)
+						}
+						hits, sent = got, text
+					}
+					if hits.n != 1 || hits.took != tc.elapsed {
+						t.Fatalf("masking: hits=%d elapsed=%s, want one hit and %s", hits.n, hits.took, tc.elapsed)
+					}
+					noted := noteMasked(nil, "chat", hits, sent, 0, "fixture", "fixture")
+					if noted == nil {
+						t.Fatal("no masking record")
+					}
+					record, ok := maskrec.Get(noted.Key)
+					if !ok || record.Took != tc.micros {
+						t.Fatalf("record: found=%t elapsed=%d microseconds, want %d", ok, record.Took, tc.micros)
+					}
+				})
+			})
+		}
+	}
+}
